{
	"name": "nexchain",
	"version": "0.1.0",
	"description": "NexChain a Next Generation blockChains.",
	"main": "main.js",
	"scripts": {
		"test": "jest",
		"build": "bun run initial && tsc",
		"format": "prettier --write .",
		"check": "bun initial && bunx tsc && rm -r dist",
		"initial": "bun run ./common/init.ts",
		"pre": "npx tsc && rm -r dist",
		"prepare": "husky",
		"check:browser": "esbuild scripts/browserWalletEntry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser-check.mjs --log-limit=0 && rm -f dist/browser-check.mjs",
		"check:tx": "bun run scripts/txPathCheck.ts",
		"check:wallet": "bun run scripts/walletVaultCheck.ts",
		"check:difficulty": "bun run scripts/difficultyRetargetCheck.ts",
		"rpc:start": "bun run rpc/server.ts",
		"miner": "bun run mine.ts",
		"explorer:dev": "bun run --cwd explorer dev",
		"explorer:build": "bun run --cwd explorer build",
		"wallet:dev": "bun run --cwd wallet-ui dev",
		"wallet:build": "bun run --cwd wallet-ui build",
		"wallet:typecheck": "bun run --cwd wallet-ui typecheck",
		"wallet:smoke": "bun run --cwd wallet-ui smoke"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZenMuhamadX/Nexchain.git"
	},
	"bin": {
		"nex": "src/cli/command/command.ts"
	},
	"author": "Zen",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ZenMuhamadX/Nexchain/issues"
	},
	"homepage": "https://github.com/ZenMuhamadX/Nexchain#readme",
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@types/debug": "^4.1.13",
		"@types/elliptic": "^6.4.18",
		"@types/express": "^5.0.6",
		"@types/figlet": "^1.7.0",
		"@types/jest": "^29.5.14",
		"@types/levelup": "^5.1.5",
		"@types/lodash": "^4.17.25",
		"@types/msgpack-lite": "^0.1.12",
		"@types/node": "^22.20.4",
		"@types/rocksdb": "^3.0.5",
		"@types/secp256k1": "^4.0.7",
		"@types/ws": "^8.18.1",
		"assemblyscript": "^0.27.37",
		"bun-types": "latest",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"fake-indexeddb": "^6.2.5",
		"globals": "^15.15.0",
		"jest": "^29.7.0",
		"pino-pretty": "^13.1.3",
		"ts-jest": "^29.4.13",
		"typescript-eslint": "^8.70.1"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@types/cors": "^2.8.19",
		"@wasmer/wasi": "^1.2.2",
		"@wasmer/wasm-transformer": "^0.12.0",
		"@wasmer/wasmfs": "^0.12.0",
		"axios": "^1.20.0",
		"bip32": "^5.0.1",
		"bip39": "^3.1.0",
		"bs58": "^6.0.0",
		"bs64": "^0.1.0",
		"bullmq": "^5.81.5",
		"chalk": "^5.6.2",
		"commander": "^12.1.0",
		"cors": "^2.8.6",
		"crypto-js": "^4.2.0",
		"debug": "^4.4.3",
		"dotenv": "^16.6.1",
		"elliptic": "^6.6.1",
		"express": "^4.22.3",
		"express-rate-limit": "^7.5.1",
		"figlet": "^1.11.4",
		"helmet": "^8.3.0",
		"husky": "^9.1.7",
		"idb": "^8.0.3",
		"inquirer": "^12.11.1",
		"joi": "^17.13.8",
		"js-sha256": "^1.0.0",
		"js-sha3": "^0.9.3",
		"json-rpc-2.0": "^1.8.1",
		"level": "^10.0.0",
		"levelup": "^5.1.1",
		"lodash": "^4.18.1",
		"navigator": "^1.0.1",
		"pino": "^9.14.0",
		"pino-multi-stream": "^6.0.0",
		"prettier": "^3.9.9",
		"secp256k1": "^5.0.2",
		"tiny-secp256k1": "^2.2.4",
		"ts-node": "^10.9.2",
		"winston": "^3.19.0",
