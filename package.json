{
	"name": "nexchain",
	"version": "0.1.0",
	"description": "NexChain a Next Generation blockChains.",
	"scripts": {
		"build": "tsc",
		"format": "prettier --write .",
		"check": "bunx tsc && bun run clean",
		"clean": "bun run scripts/clean.ts",
		"prepare": "husky",
		"check:browser": "esbuild scripts/browserWalletEntry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser-check.mjs --log-limit=0 && rm -f dist/browser-check.mjs",
		"check:tx": "bun run scripts/txPathCheck.ts",
		"check:amount": "bun run scripts/amountCheck.ts",
		"check:wallet": "bun run scripts/walletVaultCheck.ts",
		"check:cap": "bun run scripts/supplyCapCheck.ts",
		"check:difficulty": "bun run scripts/difficultyRetargetCheck.ts",
		"check:consensus": "bun run scripts/consensusRulesCheck.ts",
		"check:rpc": "bun run scripts/rpcSecurityCheck.ts",
		"check:p2p": "bun run scripts/p2pCheck.ts",
		"check:txpolicy": "bun run scripts/txPolicyCheck.ts",
		"check:storage": "bun run scripts/storageCheck.ts",
		"check:journal": "bun run scripts/journalCheck.ts",
		"check:reorg": "bun run scripts/reorgCheck.ts",
		"check:mempool-reserve": "bun run scripts/mempoolReserveCheck.ts",
		"check:mempool-sweep": "bun run scripts/mempoolSweepCheck.ts",
		"check:pow": "bun run scripts/powParityCheck.ts",
		"check:nonce-order": "bun run scripts/nonceOrderCheck.ts",
		"check:data": "bun run scripts/dataDirCheck.ts",
		"check:all": "bun run scripts/checkAll.ts",
		"pow:bench": "bun run scripts/powBench.ts",
		"genesis:check": "bun run scripts/genesisCheck.ts",
		"genesis:solve": "bun run scripts/genesisCheck.ts --solve",
		"rpc:start": "bun run apps/node/server.ts",
		"explorer:dev": "bun run --cwd explorer dev",
		"explorer:build": "bun run --cwd explorer build",
		"wallet:dev": "bun run --cwd wallet dev",
		"wallet:build": "bun run --cwd wallet build",
		"wallet:build:desktop": "bun run --cwd wallet build:desktop",
		"wallet:typecheck": "bun run --cwd wallet typecheck",
		"wallet:smoke": "bun run --cwd wallet smoke",
		"wallet:smoke:desktop": "bun run --cwd wallet smoke:desktop",
		"wallet:smoke:portable": "bun run --cwd wallet smoke:portable",
		"wallet:desktop": "bun run --cwd wallet desktop",
		"wallet:desktop:dev": "bun run --cwd wallet desktop:dev",
		"wallet:dist": "bun run --cwd wallet desktop:dist",
		"wallet:portable": "bun run --cwd wallet desktop:portable",
		"wallet:installer": "bun run --cwd wallet desktop:installer",
		"miner:dev": "bun run --cwd miner-ui dev",
		"miner:build": "bun run --cwd miner-ui build",
		"miner:typecheck": "bun run --cwd miner-ui typecheck",
		"miner:smoke": "bun run scripts/minerUiSmoke.ts",
		"p2p:smoke": "bun run scripts/p2pSmoke.ts",
		"p2p:evil": "bun run scripts/evilPeer.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZenMuhamadX/Nexchain.git"
	},
	"author": "Zen",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ZenMuhamadX/Nexchain/issues"
	},
	"homepage": "https://github.com/ZenMuhamadX/Nexchain#readme",
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/debug": "^4.1.13",
		"@types/elliptic": "^6.4.18",
		"@types/express": "^4.17.21",
		"@types/figlet": "^1.7.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.4",
		"bun-types": "latest",
		"esbuild": "^0.28.2",
		"fake-indexeddb": "^6.2.5",
		"husky": "^9.1.7",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"bip32": "^5.0.1",
		"bip39": "^3.1.0",
		"bs58": "^6.0.0",
		"chalk": "^5.6.2",
		"cors": "^2.8.6",
		"debug": "^4.4.3",
		"dotenv": "^16.6.1",
		"elliptic": "^6.6.1",
		"express": "^4.22.3",
		"express-rate-limit": "^7.5.1",
		"figlet": "^1.11.4",
		"helmet": "^8.3.0",
		"idb": "^8.0.3",
		"inquirer": "^12.11.1",
		"joi": "^17.13.8",
		"js-sha256": "^1.0.0",
		"js-sha3": "^0.9.3",
		"json-rpc-2.0": "^1.8.1",
		"level": "^10.0.0",
		"lodash": "^4.18.1",
		"qrcode": "^1.5.4",
		"winston": "^3.19.0"
	},
	"type": "module"
}
