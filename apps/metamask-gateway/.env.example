# Gateway MetaMask — salin ke .env di folder ini, atau set di service manager.
# Endpoint RPC node yang dipanggil gateway. Arahkan langsung ke node, bukan ke
# proxy/load balancer yang meminta autentikasi terpisah. Nilai di bawah adalah
# contoh untuk node lokal.
NEX_RPC_URL=http://127.0.0.1:2008/rpc

# Kredensial Basic Auth node. Nilai di bawah contoh devnet; ganti sesuai node.
RPC_USER=nexchain
RPC_PASSWORD=nexchain

METAMASK_GATEWAY_PORT=8545
# METAMASK_BRIDGE_MAPPING=./data/bridge/mappings.json
