{
	"name": "nexchain-wallet-ext",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "NexChain Wallet — Chrome Extension (MV3), fully self-contained fork of wallet-ui.",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"preview:shots": "bun scripts/shootPreview.ts",
		"diag:popup": "bun scripts/diagnosePopup.ts",
		"vendor:snapshot": "bun scripts/snapshotVendor.ts",
		"vendor:check": "bun scripts/snapshotVendor.ts --check",
		"verify:independence": "bun scripts/verifyIndependence.ts"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"bip32": "^5.0.1",
		"bip39": "^3.1.0",
		"bs58": "^6.0.0",
		"buffer": "^6.0.3",
		"elliptic": "^6.6.1",
		"joi": "^17.13.8",
		"js-sha256": "^1.0.0",
		"js-sha3": "^0.9.3",
		"json-rpc-2.0": "^1.8.1",
		"qrcode": "^1.5.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.287",
		"@types/elliptic": "^6.4.18",
		"@types/node": "^22.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.5"
	}
}
