{
	"manifest_version": 3,
	"name": "NexChain Wallet",
	"version": "0.1.0",
	"description": "Dompet lokal untuk mengirim, menerima, dan melacak dana NexChain.",
	"minimum_chrome_version": "116",
	"key": "",
	"action": {
		"default_popup": "popup.html",
		"default_title": "NexChain Wallet",
		"default_icon": {
			"16": "assets/icon-16.png",
			"32": "assets/icon-32.png",
			"48": "assets/icon-48.png",
			"128": "assets/icon-128.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["inpage.js", "chunks/*.js"],
			"matches": ["http://*/*", "https://*/*"]
		}
	],
	"permissions": ["storage", "tabs"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'; connect-src *"
	},
	"icons": {
		"16": "assets/icon-16.png",
		"32": "assets/icon-32.png",
		"48": "assets/icon-48.png",
		"128": "assets/icon-128.png"
	}
}
