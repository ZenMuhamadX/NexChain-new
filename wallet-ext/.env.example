# Salin ke `.env` lalu sesuaikan. Di-bake saat `bun run build`.
#
# Endpoint RPC default. Untuk extension, nilai ini bisa di-override saat
# runtime lewat Settings (tersimpan di chrome.storage.local).
# Kosong = jatuh ke http://localhost:8000/rpc (dev lokal).
#
# Deploy devnet online — WAJIB diisi (halaman/popup tidak boleh fetch http
# lintas-origin tanpa izin; pastikan host ada di host_permissions manifest).
# VITE_RPC_URL=https://rpc.domain.com/rpc
VITE_RPC_URL=

# Base URL explorer untuk link tx di History / hasil Send.
# Local dev: http://localhost:5173
# Production: https://explorer.domain.com
# VITE_EXPLORER_URL=https://explorer.domain.com
VITE_EXPLORER_URL=
