# Endpoint JSON-RPC NexChain (POST /rpc). WAJIB diisi saat build —
# explorer tidak punya fallback, nilai kosong = fetch gagal.
# Path WAJIB `/rpc`: server hanya menerima POST di situ, jadi tanpa path
# ini setiap request berakhir 404 dan UI tampil "RPC unreachable".
# Local:  VITE_RPC_URL=http://localhost:8000/rpc
# VPS:    VITE_RPC_URL=https://rpc.domain.com/rpc
VITE_RPC_URL=http://localhost:8000/rpc
