# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Identitas jaringan devnet (standar PoW Bitcoin):
#   NEX_NETWORK — nama jaringan (devnet / testnet / mainnet). Hanya untuk
#                 label — nilai TIDAK ikut di-hash.
#   NEX_CHAIN_ID — chain id (EIP-155). IKUT di-hash ke genesis & transaksi;
#                  semua node di satu jaringan WAJIB sama. Mengubah nilai ini
#                  tanpa re-solve genesis akan membuat node menolak start
#                  (lihat nexchain/block/genesis.ts & `bun run genesis:solve`).
NEX_NETWORK=devnet
NEX_CHAIN_ID=26

# Port HTTP JSON-RPC server
NEX_RPC_PORT=8000

# Host bind — siapa yang boleh mengakses RPC:
#   127.0.0.1 = hanya mesin ini sendiri (DIANJURKAN untuk VPS di belakang
#               Nginx Proxy Manager / reverse proxy lain — port 8000 TIDAK
#               perlu dibuka di firewall, cukup 80/443 ke proxy)
#   0.0.0.0   = semua interface (dev lokal multi-mesin: miner/explorer di PC
#               lain pada LAN yang sama)
RPC_BIND_HOST=127.0.0.1

# URL RPC untuk klien (miner / explorer / wallet dari mesin LAIN):
# NEX_RPC_URL=https://rpc.domain-anda.com/rpc
