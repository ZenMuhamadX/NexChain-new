# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Identitas jaringan devnet (standar PoW Bitcoin):
#   NEX_NETWORK — nama jaringan (devnet / testnet / mainnet). Hanya untuk
#                 label — nilai TIDAK ikut di-hash.
#   NEX_CHAIN_ID — chain id (EIP-155). IKUT di-hash ke genesis & transaksi;
#                  semua node di satu jaringan WAJIB sama. Mengubah nilai ini
#                  tanpa re-solve genesis akan membuat node menolak start
#                  (lihat nexchain/block/genesis.ts & `bun run genesis:solve`).
NEX_NETWORK=devnet
NEX_CHAIN_ID=26

# Lokasi penyimpanan data node (LevelDB: block, history, memPool, state,
# storeData). OPSIONAL — dev tidak perlu menyetel ini.
#
# Default: `./data` relatif terhadap folder tempat node dijalankan. Nilai
# relatif diselesaikan terhadap cwd; nilai absolut dipakai apa adanya.
#
# Produksi (dijalankan sebagai service): arahkan ke luar repo, mis.
#   Linux   NEX_DATA_DIR=/var/lib/nexchain
#   Windows NEX_DATA_DIR=%PROGRAMDATA%\NexChain
#
# PERINGATAN: mengubah nilai ini TIDAK memindahkan data lama — node akan
# memulai rantai baru di lokasi baru. Pindahkan isi foldernya secara manual
# bila rantai sudah berisi.
# NEX_DATA_DIR=./data

# Port HTTP JSON-RPC server
NEX_RPC_PORT=8000

# Host bind — siapa yang boleh mengakses RPC:
#   127.0.0.1 = hanya mesin ini sendiri (DIANJURKAN untuk VPS di belakang
#               Nginx Proxy Manager / reverse proxy lain — port 8000 TIDAK
#               perlu dibuka di firewall, cukup 80/443 ke proxy)
#   0.0.0.0   = semua interface (dev lokal multi-mesin: miner/explorer di PC
#               lain pada LAN yang sama)
# Default bila TIDAK diset: 127.0.0.1 (secure by default).
RPC_BIND_HOST=127.0.0.1

# URL RPC untuk klien (miner / explorer / wallet dari mesin LAIN):
# NEX_RPC_URL=https://rpc.domain-anda.com/rpc

# ---------------------------------------------------------------------------
# Keamanan RPC — baca bagian ini sebelum mengekspos node
# ---------------------------------------------------------------------------

# HTTP Basic Auth untuk METHOD TULIS:
#   nex_sendTransaction, nex_sendRawTransaction, nex_getWork, nex_submitWork
# Method baca (blok, saldo, riwayat, dll) TIDAK pernah meminta autentikasi.
#
#   - Loopback (default) + keduanya kosong → method tulis hanya menerima
#     koneksi dari mesin ini sendiri; cukup untuk development lokal.
#   - Bind non-loopback (0.0.0.0 / IP LAN / VPS) → KEDUANYA WAJIB diisi,
#     kalau tidak node MENOLAK start.
#   - PERINGATAN: WAJIB diisi saat node di-expose ke internet atau DI
#     BELAKANG PROXY/DOCKER BRIDGE — di situ alamat remote terlihat sebagai
#     loopback, sehingga tanpa kredensial siapa pun yang menembus proxy
#     bebas memanggil method tulis (kirim transaksi, minta kerja mining).
#
# Klien memakainya sebagai berikut:
#   - miner CLI      : env NEX_RPC_USER / NEX_RPC_PASS
#   - miner Rust     : flag --user / env NEX_RPC_USER + NEX_RPC_PASS
#   - wallet         : isi "RPC Username" & "RPC Password" di layar Settings
#   - curl           : curl -u user:pass ...
# RPC_USER=
# RPC_PASSWORD=

# Allowlist origin CORS, dipisah koma (tanpa spasi). Default saat TIDAK diset:
#   http://localhost:5173,http://localhost:5174,
#   http://127.0.0.1:5173,http://127.0.0.1:5174,null
# yaitu port dev Vite explorer (5173) / wallet (5174).
#
# `null` (harfiah) dibutuhkan shell wallet Electron yang dimuat dari file://,
# karena browser mengirim `Origin: "null"` untuk halaman file:// — tanpa
# entri itu wallet desktop tidak bisa memanggil RPC sama sekali. Tetap aman:
# method tulis terproteksi Basic Auth di atas, dan yang terbaca hanya data
# rantai publik. Hapus `null` bila tidak memakai shell desktop.
# RPC_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Jaringan P2P (OPSIONAL — default MATI)
# ---------------------------------------------------------------------------
# Node hanya tersambung ke peer lain bila NEX_P2P_ENABLED diset truthy
# (1/true/yes/on). Tanpa itu, node RPC/mining berjalan persis seperti biasa.
#
# Transport: TCP + frame JSON (protocol v1). Node TIDAK punya identitas atau
# tanda tangan — peer dikenali dari host:port (gaya awal Bitcoin). Keamanan
# blok tetap dari PoW + hash chain: node hanya MEMVERIFIKASI, tidak pernah
# menandatangani apa pun.
#
# NEX_P2P_ENABLED=1
#
# Port listen P2P (default 30303). Ganti bila menjalankan lebih dari satu node
# di satu mesin (atur juga NEX_DATA_DIR & NEX_RPC_PORT agar tidak bentrok).
# NEX_P2P_PORT=30303
#
# Host bind P2P (default 127.0.0.1). Sama seperti RPC: loopback = aman untuk
# dev lokal. Set 0.0.0.0 HANYA bila node lain di LAN harus menyambung — P2P
# tidak punya autentikasi, jadi batasi lewat firewall. Saat 0.0.0.0, log
# listener menampilkan IPv4 LAN mesin (bukan 0.0.0.0) — pakai itu sebagai seed
# di node lain. Ini hanya tampilan; bind-nya tetap ke semua antarmuka.
# NEX_P2P_BIND_HOST=127.0.0.1
#
# Seed peer statis, dipisah koma (host:port,host:port). Node menyambung ke
# seed lalu menyinkronkan rantai (getblocks -> inv -> getdata -> block).
# NEX_P2P_PEERS=127.0.0.1:30303
#
# Batas jumlah peer serentak (default 8).
# NEX_P2P_MAX_PEERS=8
#
# Batas ukuran satu pesan P2P dalam byte (default 10485760 = 10 MB). Pagar
# terhadap pesan raksasa: frame di atas batas ditolak SEBELUM dialokasikan.
# NEX_P2P_MAX_MSG_BYTES=10485760
#
# Batas waktu & interval (ms) — biasanya tidak perlu diubah:
#   NEX_P2P_HANDSHAKE_TIMEOUT_MS=10000   batas handshake sejak koneksi
#   NEX_P2P_IDLE_TIMEOUT_MS=120000       putus bila idle selama ini
#   NEX_P2P_PING_INTERVAL_MS=30000       jeda ping keepalive
#   NEX_P2P_BAN_MS=3600000               durasi ban peer pelanggar
#   NEX_P2P_RECONNECT_INTERVAL_MS=15000  jeda reconnect ke seed
#   NEX_P2P_SYNC_INTERVAL_MS=10000       jeda sync berkala
#
# Pacing layanan P2P: banyak item dilayani per giliran sebelum menyerahkan
# giliran ke event loop (`forEachChunked`/`yieldToLoop`). Mencegah satu
# permintaan peer (getblocks/getdata/inv) memonopoli proses, sehingga RPC
# (`nex_getWork`) dan UI tetap responsif saat peer lain mengejar rantai (IBD).
# Default 32. Nilai < 1 atau bukan angka jatuh ke default.
# NEX_P2P_SERVE_CHUNK=32
#
# Katup pengaman IBD (ms): sementara node mengejar rantai peer, `nex_getWork`
# DITOLAK agar miner tidak menambang di atas tip yang basi. Bila tidak ada
# kemajuan selama ini (peer mandek / seed tak terjangkau), node menganggap
# rantai sudah menyusul dan membuka kembali mining. Floor 1000 ms.
# NEX_P2P_SYNC_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Log berkas (OPSIONAL)
# ---------------------------------------------------------------------------
# Node SELALU menulis log ke berkas, apa pun yang tampil di konsol. Aturannya:
#
#   konsol — pelit. Hanya peristiwa penting & galat. Baris level debug baru
#            muncul bila node dijalankan dengan flag `--debug`.
#   berkas — lengkap. SEMUA level ikut tercatat, termasuk baris debug yang
#            tidak dicetak ke konsol.
#
# Tujuan: konsol tetap enak dibaca sementara riwayat penuh tetap tersedia
# setelah kejadian (mis. untuk menelusuri kenapa sebuah peer diputus).
#
# Direktori log. Relatif diselesaikan terhadap cwd (sama seperti NEX_DATA_DIR),
# BUKAN terhadap lokasi berkas sumber.
# NEX_LOG_DIR=./logs
#
# Retensi dalam HARI: berkas per hari UTC (`nex-YYYY-MM-DD.log`), simpan N hari
# terakhir TERMASUK hari ini, sisanya dihapus saat node start. Default 3.
# Contoh: 2026-10-16 dengan retensi 3 -> 16, 15, 14 disimpan; 13 ke bawah dihapus.
# NEX_LOG_RETENTION_DAYS=3
